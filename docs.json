            ]
          }
        ]
      },
      {
        "tab": "Интеграции",
        "groups": [
          {
            "group": "Интеграции",
            "pages": [
              "integrations/overview",
              "integrations/claude-code",
              "integrations/cursor",
              "integrations/cline",
              "integrations/continue",
              "integrations/aider",
              "integrations/zed",
              "integrations/sdk"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/ethereal.svg",
    "dark": "/logo/ethereal.svg"
